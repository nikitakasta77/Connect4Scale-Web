# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/connect4scale
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connect4scale
MONGODB_URI=mongodb://127.0.0.1:27017/connect4scale

# Comma-separated list of origins allowed to call this API (your frontend URL(s)).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Secret key admin tools/dashboards must send as the `x-api-key` header to
# create/update/delete content or read contact form submissions. Generate a
# long random value — e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=changeme-generate-a-long-random-secret
